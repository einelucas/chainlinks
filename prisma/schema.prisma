// Schema do banco de dados — Plataforma de Linktree customizável
// Para produção, troque o provider para "postgresql" e use uma DATABASE_URL
// de um serviço como Vercel Postgres, Neon ou Supabase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // troque para "postgresql" em produção
  url      = env("DATABASE_URL")
  // Em produção com Postgres + pooler (Neon/Supabase/Vercel Postgres),
  // descomente a linha abaixo e defina DIRECT_URL no .env — o Prisma usa
  // essa conexão direta (sem pooler) apenas para migrate/db push.
  // directUrl = env("DIRECT_URL")
}

// ---------- Página pública (o "linktree" de cada usuário) ----------
//
// A autenticação/identidade do usuário vive no Supabase Auth (auth.users),
// um banco Postgres separado deste (Neon). Por isso `userId` não é uma
// foreign key de verdade — é o UUID de auth.users.id do Supabase, mantido
// consistente só a nível de aplicação (ver src/lib/ensure-page.ts).

model Page {
  id     String @id @default(cuid())
  userId String @unique // auth.users.id do Supabase

  // Identidade
  username     String  @unique // usada na URL pública: /username
  displayName  String  @default("Meu Perfil")
  bio          String  @default("")
  profileImage String? // data URI (base64) ou URL
  profileImageSize Int @default(104) // px, 64-200
  favicon      String?

  // Layout de fundo
  bgType          String  @default("color") // "color" | "gradient" | "image"
  bgColor         String  @default("#0a0a0a")
  bgGradientFrom  String  @default("#0a0a0a")
  bgGradientTo    String  @default("#111111")
  bgGradientAngle Int     @default(135)
  bgImage         String? // data URI (base64) ou URL
  overlayOpacity  Float   @default(0.7) // escurece a imagem de fundo (0 a 1)

  // Tipografia
  fontFamily String @default("Montserrat") // nome de fonte do Google Fonts
  fontSize   Int    @default(16) // tamanho base da tipografia em px
  textColor  String @default("#ffffff")
  bioColor   String @default("#dcdcdc")

  // Botões de link
  buttonBgColor     String @default("rgba(0,0,0,0.55)")
  buttonBorderColor String @default("#00ff6a")
  buttonTextColor   String @default("#ffffff")
  buttonRadius      Int    @default(50) // px, 50 = totalmente arredondado
  buttonSize        String @default("medium") // "small" | "medium" | "large"
  buttonShadowColor String @default("rgba(0,255,100,0.15)")

  // Hover
  hoverBgColor   String @default("rgba(0,255,100,0.15)")
  hoverGlowColor String @default("rgba(0,255,100,0.45)")
  hoverScale     Float  @default(1.04)

  // Outros
  accentColor     String  @default("#00ff6a") // cor de destaque geral (ícones, títulos)
  showShareButton Boolean @default(true)
  showQrButton    Boolean @default(true)
  isPublished     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  links       LinkItem[]
  socialIcons SocialIcon[]

  @@map("pages")
}

// ---------- Links principais (os botões grandes) ----------

model LinkItem {
  id     String @id @default(cuid())
  pageId String
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  label    String
  url      String
  icon     String? // data URI (base64), URL, ou nome de ícone da biblioteca embutida
  order    Int     @default(0)
  isActive Boolean @default(true)
  clicks   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId, order])
  @@map("link_items")
}

// ---------- Ícones sociais (rodapé: whatsapp, instagram, email, telefone...) ----------

model SocialIcon {
  id     String @id @default(cuid())
  pageId String
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  platform String // "whatsapp" | "instagram" | "facebook" | "email" | "phone" | "custom" ...
  url      String
  icon     String? // data URI (base64) ou URL, sobrescreve o ícone padrão da plataforma
  order    Int     @default(0)

  createdAt DateTime @default(now())

  @@index([pageId, order])
  @@map("social_icons")
}
