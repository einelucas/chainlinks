DATABASE_URL="postgresql://usuario:senha@host:5432/chainlinks"

# Supabase Auth — mediador do login (senha e Google). URL do projeto e
# publishable key (públicas, seguras no navegador). Encontre em
# Project Settings > API no painel do Supabase.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Login com Google (OAuth) — configure o provider Google em
# Authentication > Providers no painel do Supabase (client ID/secret do
# Google Cloud Console ficam lá, não aqui). URI de redirecionamento a
# autorizar no Google Cloud Console:
# {NEXT_PUBLIC_SUPABASE_URL}/auth/v1/callback
